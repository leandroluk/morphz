    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "morphz": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "26.3.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  },
  "peerDependencies": {
    "typescript": "^5.6.0"
  }
}
