{
  "name": "morphz-vscode",
  "displayName": "morphz",
  "version": "0.0.1",
  "description": "Editor support for morphz: activates the morphz TypeScript Language Service Plugin for Struct/Define hover, autocomplete, and diagnostics — zero tsconfig.json editing required.",
  "categories": [
    "Linters",
    "Programming Languages"
  ],
  "keywords": [
    "intellisense",
    "language-service-plugin",
    "morphz",
    "typescript",
    "zod"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leandroluk/morphz.git",
    "directory": "packages/vscode"
  },
  "publisher": "leandroluk",
  "main": "./dist/extension.js",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "26.3.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "contributes": {
    "typescriptServerPlugins": [
      {
        "name": "morphz",
        "enableForWorkspaceTypeScriptVersions": true
      }
    ]
  },
  "activationEvents": [
    "onLanguage:typescript",
    "onLanguage:typescriptreact"
  ],
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#0d9488",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.90.0"
  }
}
